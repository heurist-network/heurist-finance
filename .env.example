# Copy to .env and fill in real values. .env is gitignored.
HEURIST_API_KEY=            # Heurist Mesh: yahoo, fred, sec, exa tools. Get one at https://heurist.ai/credits
EODHD_API_KEY=              # daily bars, quotes and the monitor's prices (https://eodhd.com)
# MESH_API_ENDPOINT=https://mesh.heurist.xyz
ANTHROPIC_API_KEY=          # brief and watch agents (scripts/brief.py, scripts/watch.py)
TELEGRAM_BOT_TOKEN=         # optional; without it notifications print to stdout
TELEGRAM_CHAT_ID=
SEC_USER_AGENT=             # SEC asks for a contact, e.g. "Your Name you@example.com"
FINRA_CLIENT_ID=            # optional, bond-data skill: FINRA API public credential
FINRA_CLIENT_SECRET=
